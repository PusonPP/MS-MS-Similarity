params.outdir = "${projectDir}/results"
manifest {
    name = 'biof501-msms'
    nextflowVersion = '24.10.4'
}
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    maxForks = 1
    container = 'biof501-msms:1.0'
}
executor.queueSize = 1
docker.enabled = true
docker.runOptions = '--network none --memory 2g --cpus 1'
trace {
    enabled = true
    file = "${params.outdir}/trace.tsv"
    overwrite = true
    fields = 'task_id,name,status,exit,realtime,peak_rss,cpus,memory'
}
